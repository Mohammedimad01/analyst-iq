# Copy to `.env` in the repository root. The backend reads this file; never commit `.env`.

# --- Database ---------------------------------------------------------------
# Neon connection string from the Neon console ("Connection string", pooled or direct).
# Example shape: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# If left empty, the backend falls back to a local SQLite file (backend/analyst_iq.db)
# for demo/development only. PostgreSQL is the supported production database.
DATABASE_URL=

# --- API --------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=10

# --- Gemini (used from Milestone 2; the app starts without it) --------------
GEMINI_API_KEY=
# A model your key can use. List them with:  python -m app.cli gemini-models   (run from backend/)
# Free-tier availability and limits differ per account and change over time; check Google AI Studio.
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=30
# Cost guards for AI generation (stored insights per minute / per 24 h).
AI_MAX_REQUESTS_PER_MINUTE=5
AI_MAX_REQUESTS_PER_DAY=100
